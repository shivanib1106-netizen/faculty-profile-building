# ==============================================================================
# Faculty Profile Builder - Backend Environment Configuration Template
# Copy this file to `.env` inside `backend/` and replace placeholder values.
# NEVER commit the real `.env` file to version control.
# ==============================================================================

# Flask Server
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=false
HOST=127.0.0.1
PORT=5000

# Application Secrets (Generate long random values for production)
# Example: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-different-long-random-secret

# JWT Token Lifetime in seconds (86400 = 24 hours)
JWT_ACCESS_TOKEN_EXPIRES=86400

# MySQL Database Connection Settings
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=faculty_app
DB_PASSWORD=replace-with-database-password
DB_NAME=faculty_api_db

# Optional direct SQLAlchemy connection URI (overrides individual DB_* parameters)
DATABASE_URL=mysql+pymysql://faculty_app:replace-with-database-password@127.0.0.1:3306/faculty_api_db?charset=utf8mb4

# Document Upload & File Handling
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,doc,docx
REQUIRE_ACTIVITY_DOCUMENT_FOR_SUBMISSION=false

# Cross-Origin Resource Sharing (CORS)
# For development: * or http://localhost:5173
# For production: comma-separated list of trusted origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Password Policy
PASSWORD_MIN_LENGTH=8

# Seed / Demo Account Initial Passwords (Change immediately after first login)
SEED_ADMIN_PASSWORD=AdminDemo123!
SEED_HOD_PASSWORD=HodDemo123!
SEED_FACULTY_PASSWORD=FacultyDemo123!
